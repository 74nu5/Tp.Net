<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <!-- The Aspire app host: starts the API and the front end, and the dashboard that shows their telemetry. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>tp-net-tickets-apphost</UserSecretsId>
    <!-- The orchestrator and the dashboard come from NuGet packages: no need to install the Aspire CLI. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tickets.Api\Tickets.Api.csproj" />
    <ProjectReference Include="..\Tickets.Web\Tickets.Web.csproj" />
  </ItemGroup>

</Project>
