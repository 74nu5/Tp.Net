@* Exercise 02: parameters, an event to the parent, and free content from the parent.
   Exercise 07: scoped CSS (TicketCard.razor.css) and a JavaScript module (TicketCard.razor.js).
   TP-04, exercise 04: a shared favorites state, and a cascading "Compact" value from an ancestor. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject FavoritesState Favorites

<article class="ticket-card">
    <header>
        <PriorityBadge Priority="Ticket.Priority" />
        <h3>@Ticket.Title</h3>
    </header>

    @if (!Compact && !string.IsNullOrWhiteSpace(Ticket.Description))
    {
        <p>@Ticket.Description</p>
    }

    <footer>
        <button type="button" class="select" @onclick="SelectAsync">Select</button>
        <button type="button" class="copy" @onclick="CopyTitleAsync">Copy title</button>
        <button type="button" class="favorite" aria-pressed="@Favorites.IsFavorite(Ticket.Id)" @onclick="() => Favorites.Toggle(Ticket.Id)">
            @(Favorites.IsFavorite(Ticket.Id) ? "★ Favorite" : "☆ Favorite")
        </button>
        @ChildContent
    </footer>
</article>

@code {
    private IJSObjectReference? _module;

    /// <summary>The ticket to display. EditorRequired: the IDE warns when it is missing.</summary>
    [Parameter, EditorRequired]
    public TicketDto Ticket { get; set; } = default!;

    /// <summary>Raised when the user selects the ticket. The parent decides what to do.</summary>
    [Parameter]
    public EventCallback<TicketDto> OnSelected { get; set; }

    /// <summary>
    /// Set by a CascadingValue named "Compact" anywhere above: no need to pass it through every level.
    /// </summary>
    [CascadingParameter(Name = "Compact")]
    public bool Compact { get; set; }

    /// <summary>Extra markup from the parent, rendered in the footer.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // EventCallback re-renders the parent once its handler has run: no StateHasChanged needed there.
    private Task SelectAsync() => OnSelected.InvokeAsync(Ticket);

    private async Task CopyTitleAsync()
    {
        // The module next to the component is served at the same path as the .razor file. In a Blazor Web App,
        // the client project's files are served from the root (in a Razor class library, under _content/<library>/).
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/TicketCard.razor.js");
        await _module.InvokeVoidAsync("copyText", Ticket.Title);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser is gone (Interactive Server): nothing left to clean up.
            }
        }
    }
}
